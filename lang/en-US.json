  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.AllRoadProgress]": "Completed, active, failed and skipped road segments. Junction work is grouped into a final phase after road segments.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.Arrows]": "Prioritizes stop-approach direction arrows from actual permissions, adding missing native arrows. Uses left+U-turn only without straight/right permissions. Advance U-turn paint goes upstream of all diamonds with at least 3 m clearance; omits the U-turn warning first when space is insufficient.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.ArrowStopDistance]": "Aligns the first arrow center to this distance on each incoming lane. Keeps originals if space is insufficient.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.AutoCrosswalkSize]": "Double-row selections check smaller sizes down to 2 m. Single-row 3 m stays single-row. Keeps the original position if setback cannot fit.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.Brush]": "While the tool is active, Shift+R cycles white, yellow, double yellow and yellow zigzag. Click to apply.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.BulkCategory]": "Replaces the selected category.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.BulkCenter]": "Style for center line replacement.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.BulkCrosswalk]": "Size for all crossings.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.BulkEdge]": "Style for edge replacement.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.BulkPaving]": "Style for all sidewalks.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.CenterSide]": "Paint the clicked carriageway or both sides of a median. Default: clicked side only.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.CrosswalkBrush]": "Use Korean crosswalks in Roads and click near a crossing. Shift+R cycles double-row 2/3/4 m and single-row 3 m; right-click resets to default.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.CrosswalkClearance]": "Measured to the near painted edge; default 14 m. Skips relocation on short or sharply curved approaches. Set 0 to disable. Connected pedestrian paths move when synchronization is enabled; signal objects remain in place.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.Crosswalks]": "Applies Korean crosswalk paint. Path relocation follows the traffic synchronization option.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.DefaultCenter]": "Center style used by Replace all road styles.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.DefaultCrosswalk]": "Narrow roads default to single-row 3 m. Other roads default to double-row 3 m. Double-row widths: 4.2 / 6.2 / 8.2 m. Press Replace all after changes.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.DefaultEdge]": "Used on roads without a side override. Default is Original.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.DefaultPaving]": "Paving style used by Replace all road styles.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.DiamondCount]": "Number per incoming lane.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.DiamondDistance]": "Measured upstream from the stop line.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.Diamonds]": "Paints each incoming lane; skips markings that do not fit the approach.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.DiamondSpacing]": "Distance between diamond centers.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.EdgeLaneGap]": "Distance from the outer driving-lane boundary to the inner edge of the marking. Zero touches the lane; larger values move outward. Sidewalk overlaps and bus-bay tapers are omitted.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.EdgeLines]": "Use the Korean edge tool in Roads and click the desired side. Right-click resets that side to the default choice.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.Enabled]": "Off after each city load. Enable, then press Replace all. Disable to restore original markings.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.GuideDash]": "Measured along the curve.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.GuideGap]": "Measured along the curve.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.GuideLeftOffset]": "Clamped to half the lane width.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.HideJunctionLines]": "With left guides enabled, hides original divider, merge and center paint inside junctions. Restoring or disabling returns the original paint.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.HideTransportColor]": "Hides the red surface only; reserved-lane traffic rules remain unchanged.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.HideTransportText]": "Hides road BUS TAXI decals; disabling restores the original markings.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.HighwayCurbs]": "Include highway curbs in bulk and automatic styles.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.HighwayGutters]": "Include highway gutters in bulk and automatic styles.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.HighwayPaving]": "Include highway paving in bulk and automatic styles. Manual placement remains available.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.InspectAssets]": "Checks loaded prefabs. Replace all will not start if required assets are missing.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.LaneBoundaryCracks]": "Adds 8 m repeating cracks along existing dividers with driving lanes on both sides. Excludes crosswalks and junction interiors. Off by default. Press Replace all after changes.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.LeftGuides]": "Draws dashed guides on the vehicle's left without changing routing.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.Milliseconds]": "Checked after each road. A complex junction can exceed this soft time budget.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.PaintClearance]": "Measured from the painted crosswalk boundary.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.Paving]": "Click the highlighted region with the paving tool in Roads. Shift+R cycles 01–05; right-click restores that region. Disable and Replace all to remove paving.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.PavingBrush]": "Applies the selected style only to the clicked region.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.ReplaceAll]": "Experimental. Applies the configured default center, edge, crossing, paving and approach styles to every road, replacing individual selections, manual approach decals and guides. Resets individual curb/gutter overrides to native. Starts nearest the camera center.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.ReplaceCategoryAll]": "Apply this category and style across the city. Crosswalk changes also recalculate stop placement.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.ReplaceHighways]": "Applies all styles only to roads with the highway flag. Highway paving and other highway options are respected.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.ReplaceOrdinary]": "Applies all styles only to roads without the highway flag.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.RestoreAll]": "Cancels work and restores original visuals. Per-road edge choices are retained.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.RoadsPerFrame]": "Lower values spread application over more frames.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.Side]": "Choose the clicked side or both sides, relative to the road centerline.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.SolidApproach]": "Replaces same-direction dividers only. Preserves center lines.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.SolidMaximum]": "If lower than minimum, minimum takes priority.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.SolidMinimum]": "Short roads use only available length.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.SolidPercent]": "Fraction of the lane between nodes, bounded by minimum, maximum, and available approach length.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.SpeedSigns]": "Uses road speed; supports 10–120 km/h in steps of 10. Skips unsupported speeds or insufficient space. Text markings are manual only.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.Status]": "Shows progress and missing assets.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.StopGap]": "Default 3 m. Falls back to a 1 m gap when the approach is too short.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.StopLines]": "Paints incoming lanes regardless of signal or priority. Does not change traffic rules.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.SyncTraffic]": "Moves connected car and pedestrian endpoints to the paint. Keeps signals and priorities. Crossings with conflicting shared endpoints retain their original location.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.TurnAngle]": "At least 45 degrees. U-turn paths do not receive guides.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.UpdateEditedRoads]": "Refreshes styles on edited, styled roads. Newly built roads always receive the configured defaults.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.UTurnZoneLength]": "Default 8m, range 4–24m. Use +/− in the U-turn tool; placed zones retain their own length.",
  "Options.OPTION_DESCRIPTION[RoadStyleIntoKorea.RoadStyleIntoKorea.Mod.Settings.UTurnZones]": "On two-way roads with at least 3 total lanes and a U-turn connection, keeps 1 m of original center line upstream of the stop, then adds dashed U-turn paint followed by the original line. Does not change turn permissions. Press Replace all after changes.",
