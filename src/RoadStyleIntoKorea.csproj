<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Configurations>Debug;Release</Configurations>
    <Version>0.1.214</Version>
    <AssemblyName>RoadStyleIntoKorea</AssemblyName>
    <RootNamespace>RoadStyleIntoKorea</RootNamespace>
    <AssemblyTitle>ROAD STYLE INTO KOREA</AssemblyTitle>
    <Product>ROAD STYLE INTO KOREA</Product>
  </PropertyGroup>
  <Import Project="$(CSII_TOOLPATH)\Mod.props" />
  <Import Project="$(CSII_TOOLPATH)\Mod.targets" />
  <PropertyGroup>
    <UserDataPath>$(CSII_USERDATAPATH)</UserDataPath>
    <UnityModProjectPath>$(CSII_UNITYMODPROJECTPATH)</UnityModProjectPath>
    <ModPostProcessorPath>$(CSII_MODPOSTPROCESSORPATH)</ModPostProcessorPath>
    <ModPublisherPath>$(CSII_MODPUBLISHERPATH)</ModPublisherPath>
    <MSCORLIBPath>$(CSII_MSCORLIBPATH)</MSCORLIBPath>
    <LocalModsPath>$(MSBuildProjectDirectory)\..\local</LocalModsPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Colossal.AssetPipeline"><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.HighDefinition.Runtime;Unity.RenderPipelines.Core.Runtime"><Private>false</Private></Reference>
    <Reference Include="Game;Colossal.Core;Colossal.Logging;Colossal.IO.AssetDatabase;Colossal.Collections;Colossal.Mathematics;Colossal.Localization;Colossal.UI;Colossal.UI.Binding;UnityEngine.CoreModule;Unity.InputSystem;Unity.Collections;Unity.Entities;Unity.Mathematics">
      <Private>false</Private>
    </Reference>
    <Reference Update="System;System.Core;System.Data"><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="DeployWIP" AfterTargets="AfterBuild" Condition="'$(NeedBuild)'">
    <ItemGroup><FilesToDeploy Include="$(OutDir)\*.dll;$(OutDir)\*.pdb" /></ItemGroup>
    <MakeDir Directories="$(DeployDir)" />
    <Copy SourceFiles="@(FilesToDeploy)" DestinationFolder="$(DeployDir)" />
  </Target>
</Project>



































